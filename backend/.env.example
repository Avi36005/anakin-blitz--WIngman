# Wingman backend — copy to .env and fill in when you have keys.
# LEAVE BLANK to run in demo mode (mock data, no external calls).

ANAKIN_API_KEY=
# One key, or a comma-separated pool (rotated automatically on rate-limit):
GROQ_API_KEY=
GROQ_API_KEYS=
REDIS_URL=redis://localhost:6379
PINECONE_API_KEY=
PINECONE_INDEX=wingman-precedents
PINECONE_ENVIRONMENT=us-east-1
PORT=8000
